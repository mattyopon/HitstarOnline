# ──────────────────────────────────────────────────────────────────────────
# Hitstar Online — environment variables
# Copy to .env.local for local dev, and set the same in Vercel Project Settings.
# ──────────────────────────────────────────────────────────────────────────

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase "anon" public key (safe to expose to the browser; RLS protects data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase "service_role" secret key — SERVER ONLY. Never expose to the browser.
# Used by API routes to authoritatively mutate game state (bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=

# Optional: YouTube Data API v3 key. If set, track→videoId resolution uses the
# official API (more reliable). If empty, the server falls back to scraping
# YouTube search results. Either way results are cached in the DB.
YOUTUBE_API_KEY=

# Optional: the canonical site URL (used for OAuth redirects in some setups).
# On Vercel this is provided automatically; leave blank locally.
NEXT_PUBLIC_SITE_URL=
